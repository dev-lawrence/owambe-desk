# Sanity project and content dataset (the public one).
SANITY_PROJECT_ID=qyn1i646
SANITY_DATASET=production
# Pinned API version (a date). Bump deliberately, not automatically.
SANITY_API_VERSION=2026-09-24
# Editor-level token. Server/CLI only: never commit it or ship it to a browser.
SANITY_API_WRITE_TOKEN=

# Robot token (editor role) used ONLY by the agent runner. A separate token means every agent
# move is attributed to the agent's own robot id in workflow history. Create it with:
#   pnpm --filter @owambe/studio exec sanity tokens add "Owambe agent" --role=editor
SANITY_AGENT_TOKEN=
# Deployed schema id, needed by Agent Actions Translate. List with: sanity schema list
SANITY_SCHEMA_ID=_.schemas.owambe-desk
