# Sanity content dataset (public). Safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=qyn1i646
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-24

# Server only. Viewer token for reading drafts and workflow state (How it works page).
SANITY_API_READ_TOKEN=
# Server only. Editor token for RSVPs and aso ebi orders written by server actions.
SANITY_API_WRITE_TOKEN=

# Server only. Bachs sandbox secret key (sk_sandbox_...) and webhook signing secret. Phase 3.
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=

# Public URL of this site, used for Bachs success and cancel redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
