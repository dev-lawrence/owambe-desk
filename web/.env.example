# Sanity content dataset (public). Safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=qyn1i646
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-24

# Server only. Viewer token for reading drafts and workflow state (How it works page).
SANITY_API_READ_TOKEN=
# Server only. Editor token for RSVPs written by server actions.
SANITY_API_WRITE_TOKEN=
# Server only. Robot token (editor) the web server uses to create orders, start their
# workflow and open checkouts. Its own token, so workflow history names it.
SANITY_WEB_SERVER_TOKEN=
# Server only. Robot token (editor) used ONLY by /api/webhooks/bachs. The aso ebi workflow
# lets only robot identities confirm payments, and history shows it was this one.
SANITY_PAYMENTS_WEBHOOK_TOKEN=

# Server only. Bachs sandbox secret key (sk_sandbox_...). Live keys (sk_live_) are refused
# unless BACHS_ALLOW_LIVE=true.
BACHS_SECRET_KEY=
# Server only. The webhook endpoint's signing secret (whsec_...), from the Bachs developer
# portal or `bachs listen`. Used to verify X-Bachs-Signature-V2 on /api/webhooks/bachs.
BACHS_WEBHOOK_SECRET=

# Public URL of this site, used for Bachs success and cancel redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
