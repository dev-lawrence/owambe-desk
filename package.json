{
  "name": "owambe-desk",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:studio": "node init && pnpm --filter @owambe/studio dev",
    "dev:web": "node init && pnpm --filter @owambe/web dev",
    "dev:console": "node init && pnpm --filter @owambe/console dev",
    "seed": "pnpm --filter @owambe/scripts seed",
    "typecheck": "pnpm -r typecheck",
    "agent": "pnpm --filter @owambe/scripts agent",
    "test": "pnpm -r test",
    "rehearse": "pnpm --filter @owambe/scripts rehearse"
  }
}
